  <data name="customSqlQuery1.Sql" xml:space="preserve">
    <value>--DECLARE @ParamStartPayNo INT = 21;
--DECLARE @ParamEndPayNo INT = 76;
--DECLARE @ParamEmployeeId INT = 0;
--DECLARE @ParamPayrollGroupId INT = 51;
--DECLARE @ParamCompanyId INT = 0;
--DECLARE @ParamBranchId INT = 0;
--DECLARE @ParamDepartmentId INT = 0;

SELECT 
    MstEmployee.Id AS EmployeeId,
    MstCompany.Company,
    MstBranch.Branch,
    MstDepartment.Department,
    MstEmployee.FullName,
    CAST(
        SUM(
            CASE 
                WHEN MstEmployee.PayrollTypeId = 1 
                    THEN (TrnPayrollLine.TotalRegularWorkingAmount - TrnPayrollLine.TotalTardyAmount)
                WHEN MstEmployee.PayrollTypeId = 3 
                    THEN (MstEmployee.PayrollRate - (TrnPayrollLine.TotalAbsentAmount + TrnPayrollLine.TotalTardyAmount))
                ELSE 0
            END
        ) AS DECIMAL(18,2)
    ) AS TotalWorkingAmount
FROM TrnPayrollLine  
INNER JOIN TrnPayroll 
    ON TrnPayrollLine.PayrollId = TrnPayroll.Id
INNER JOIN MstEmployee 
    ON TrnPayrollLine.EmployeeId = MstEmployee.Id
INNER JOIN MstCompany
    ON MstEmployee.CompanyId = MstCompany.Id
INNER JOIN MstDepartment
    ON MstEmployee.DepartmentId = MstDepartment.Id
INNER JOIN MstBranch
    ON MstEmployee.BranchId = MstBranch.Id
WHERE (@ParamEmployeeId IS NULL OR @ParamEmployeeId = 0 OR MstEmployee.Id = @ParamEmployeeId)
  AND MstEmployee.PayrollGroupId = @ParamPayrollGroupId 
  AND (@ParamCompanyId IS NULL OR @ParamCompanyId = 0 OR MstEmployee.CompanyId = @ParamCompanyId)
  AND (@ParamDepartmentId IS NULL OR @ParamDepartmentId = 0 OR MstEmployee.DepartmentId = @ParamDepartmentId)
  AND (@ParamBranchId IS NULL OR @ParamBranchId = 0 OR MstEmployee.BranchId = @ParamBranchId)
  AND TrnPayroll.IsLocked = 1
  AND MstEmployee.IsLocked = 1
  AND TrnPayroll.Id BETWEEN @ParamStartPayNo AND @ParamEndPayNo
GROUP BY 
    MstEmployee.Id,
    MstEmployee.FullName,
    MstCompany.Company,
    MstBranch.Branch,
    MstDepartment.Department
HAVING 
    SUM(
        CASE 
            WHEN MstEmployee.PayrollTypeId = 1 
                THEN (TrnPayrollLine.TotalRegularWorkingAmount - TrnPayrollLine.TotalTardyAmount)
            WHEN MstEmployee.PayrollTypeId = 3 
                THEN (MstEmployee.PayrollRate - (TrnPayrollLine.TotalAbsentAmount + TrnPayrollLine.TotalTardyAmount))
            ELSE 0
        END
    ) &lt;&gt; 0
ORDER BY 
    MstEmployee.FullName;</value>
